{
  "name": "dijksarchief",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Private landing page linking to the family Google Photos albums.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "encrypt": "node scripts/build.mjs && node scripts/encrypt.mjs",
    "links:seal": "sops --encrypt links.json > links.enc.json",
    "links:open": "sops --decrypt links.enc.json > links.json"
  },
  "devDependencies": {
    "pagecrypt": "^6.0.0"
  }
}
